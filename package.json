{
  "name": "@droidsolutions-oss/semantic-release-sentry",
  "version": "2.0.1",
  "description": "Semantic release plugin to create Sentry releases",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "Sentry",
    "semantic-release",
    "semantic",
    "release",
    "plugin"
  ],
  "author": "Stefan Ißmer <stefan.issmer@droidsolutions.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/droidsolutions/semantic-release-sentry.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "@sentry/cli": "^3.6.2",
    "execa": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts,json,md,yml}": "prettier --write",
    "*.{js,mjs,ts,mts}": "eslint"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "allowScripts": {
    "@sentry/cli": true,
    "fsevents": true
  }
}
